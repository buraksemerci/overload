{
  "name": "overload",
  "version": "0.1.0",
  "private": true,
  "description": "Progresif overload merkezli antrenman, beslenme ve sağlık takip sistemi",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @overload/web dev",
    "build:web": "pnpm --filter @overload/web build",
    "lint": "pnpm --filter @overload/web lint",
    "typecheck": "pnpm -r typecheck",
    "test:web": "pnpm --filter @overload/web test",
    "gen:types": "pnpm --filter @overload/shared-types generate"
  }
}
