# =============================================================================
# overload — ortam değişkenleri şablonu
#
# KULLANIM:
#   1. Bu dosyayı kopyala:  cp .env.example .env
#   2. Aşağıdaki değerleri doldur (her birinin nereden alınacağı yanında yazıyor)
#   3. .env ASLA commit'lenmez (.gitignore'da)
#
# Backend  -> apps/api/.env     (bu dosyanın tamamı)
# Frontend -> apps/web/.env.local (sadece NEXT_PUBLIC_* olanlar)
# =============================================================================

# --- Veritabanı -------------------------------------------------------------
# Neon: console.neon.tech -> proje -> Connection string -> "SQLAlchemy" seçeneği
# ÖNEMLİ: async sürücü için şema "postgresql+asyncpg://" olmalı (psycopg2 değil).
# Neon'da ayrıca "?sslmode=require" yerine asyncpg "?ssl=require" bekler.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/overload?ssl=require

# Yerel Docker Postgres (docker compose up -d ile ayağa kalkar):
# DATABASE_URL=postgresql+asyncpg://overload:overload@localhost:5432/overload

# Alembic migration'ları senkron sürücü kullanır (aynı DB, farklı şema öneki)
DATABASE_URL_SYNC=postgresql+psycopg://user:password@ep-xxx.eu-central-1.aws.neon.tech/overload?sslmode=require

# --- Kimlik doğrulama -------------------------------------------------------
# Rastgele üret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_LIFETIME_SECONDS=604800

# --- Anthropic --------------------------------------------------------------
# console.anthropic.com -> Settings -> API keys -> Create key
# AYRICA: Settings -> Limits -> aylık harcama tavanı koy (ör. $20)
ANTHROPIC_API_KEY=
# Model katmanları — yüksek hacimli ayrıştırma vs. karmaşık muhakeme
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-5

# --- Cloudflare R2 (fotoğraf depolama, S3 uyumlu) ---------------------------
# dash.cloudflare.com -> R2 -> Create bucket -> Manage API tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=overload-media
# Biçim: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Besin veritabanları ----------------------------------------------------
# fdc.nal.usda.gov/api-key-signup (ücretsiz, e-posta ile anında gelir)
USDA_API_KEY=
# Open Food Facts anahtar istemez ama User-Agent zorunlu (kullanım politikası)
OFF_USER_AGENT=overload/0.1 (github.com/kabese/overload)

# --- URL'ler ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Ortam ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
